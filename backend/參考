
// add_question
const data = {
    "subject_id" : "test",
    "unit_id" : "test",
    "question_id" : "1",
    "question_data" : {"Q" : "6*3", "O1" : "6", "O2" : "66", "O3" : "666", "O4" : "6666", "A" : "666"}
};

fetch('/add_question', {
    method: 'POST',
    headers: {
        'Content-Type': 'application/json' // 指定內容類型為 JSON
    },
    body: JSON.stringify(data) // 將資料轉換為 JSON 格式
})
.then(response => {
    if (response.ok) {
        return response.json();
    } else {
        throw new Error('Network response was not ok');
    }
})
.then(result => {
    console.log('伺服器回傳的資料:', result);
})


返回 {"success" : true or false}


